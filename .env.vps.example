XBA_ARCHIVE_DIR=/data/archive
XBA_PROFILE_DIR=/data/profile
XBA_HEADLESS=true

# 30 seconds is the enforced minimum. 60 seconds is safer for normal use.
XBA_POLL_INTERVAL_SECONDS=60
XBA_BOOKMARK_LIMIT=50
XBA_BOOKMARK_SCROLLS=4
XBA_THREAD_SCROLLS=10
XBA_SCROLL_DELAY_MS=1200
XBA_SETUP_TIMEOUT_MS=900000

