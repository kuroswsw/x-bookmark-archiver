# All paths may be absolute or relative to the repository root.
XBA_ARCHIVE_DIR=archive
XBA_PROFILE_DIR=.browser-profile

# Scheduled runs should normally stay headless after `pnpm setup`.
XBA_HEADLESS=true
XBA_BOOKMARK_LIMIT=50
XBA_BOOKMARK_SCROLLS=8
XBA_THREAD_SCROLLS=10
XBA_SCROLL_DELAY_MS=1200
XBA_SETUP_TIMEOUT_MS=600000
